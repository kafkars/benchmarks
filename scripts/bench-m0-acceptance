#!/usr/bin/env bash
# End-to-end acceptance for the milestone-0 control plane, against a real
# cluster.
#
# The offline integration tests prove that the supervisor seals every ending it
# is supposed to seal, using a fixture adapter that only pretends to produce.
# They cannot prove that the real adapters speak the protocol, that the legacy
# topic tool and verifier still accept the argv the control plane builds, or
# that a bundle produced from an actual three-broker run classifies as valid.
# That is this script, and it is deliberately not a cargo test: it needs Docker,
# a compiled librdkafka, and several minutes.
#
# The cluster is never started here. A harness that boots its own broker is a
# harness that measures its own startup, and an acceptance run against a cluster
# somebody else's script started is the same shape as a real diagnostic run.
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

bootstrap=${1:-127.0.0.1:39092,127.0.0.1:39093,127.0.0.1:39094}
work="$repo_root/target/m0-acceptance"
results_root="$work/results"
scenario="$repo_root/scenarios/producer/legacy-balanced-1k.toml"

echo "==> checking the cluster at $bootstrap"
first=${bootstrap%%,*}
host=${first%:*}
port=${first##*:}
if ! (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null; then
  echo "no broker is listening on $first" >&2
  echo "start one with:" >&2
  echo "  docker compose -f clusters/dev-compose/compose.yml up -d --wait" >&2
  exit 69
fi

echo "==> building the adapters"
binary_root=$("$repo_root/scripts/build-benchmark-adapters")
kafkars_adapter="$binary_root/kafkars-benchmark-adapter"
librdkafka_producer="$binary_root/librdkafka-producer-benchmark"
verifier="$binary_root/librdkafka-benchmark-verifier"
for binary in "$kafkars_adapter" "$librdkafka_producer" "$verifier"; do
  if [ ! -x "$binary" ]; then
    echo "missing built binary: $binary" >&2
    exit 70
  fi
done

echo "==> building the control plane"
cargo build --locked -p benchctl -p bench-adapter-librdkafka --release
benchctl="$repo_root/target/release/benchctl"
shim="$repo_root/target/release/bench-adapter-librdkafka"

echo "==> writing the generated inputs under $work"
rm -rf "$work"
mkdir -p "$work"
cat >"$work/subjects.toml" <<TOML
# Generated by scripts/bench-m0-acceptance. Both subjects are built from this
# checkout, so the paths are absolute and the file is not meant to be committed.

[[subjects]]
name = "kafkars"
command = ["$kafkars_adapter"]

[[subjects]]
name = "librdkafka-c"
command = ["$shim", "--binary", "$librdkafka_producer"]
TOML

cat >"$work/cluster.toml" <<TOML
# Generated by scripts/bench-m0-acceptance.
#
# Topic management and read-back verification are configured tools rather than
# adapter verbs: an adapter that created its own topics could choose its own
# partition count, and one that graded its own output would not be evidence.
name = "dev-compose"
bootstrap = "$bootstrap"
broker_version = "apache/kafka:4.3.1"
security = "plaintext"
brokers = 3
lifecycle = "externally managed by the caller"

[tools]
topic_create = ["$kafkars_adapter", "topics-create"]
topic_delete = ["$kafkars_adapter", "topics-delete"]
verify = ["$verifier"]
TOML

echo "==> running the attempt"
set +e
"$benchctl" run \
  --experiment "$scenario" \
  --subjects "$work/subjects.toml" \
  --cluster "$work/cluster.toml" \
  --bootstrap "$bootstrap" \
  --results "$results_root"
run_status=$?
set -e
if [ "$run_status" -ne 0 ]; then
  echo "benchctl run exited $run_status; expected 0 (sealed complete)" >&2
  exit "$run_status"
fi

echo "==> locating the sealed bundle"
sealed_count=$(find "$results_root" -mindepth 3 -maxdepth 3 -type f -name status.json | wc -l | tr -d ' ')
if [ "$sealed_count" != "1" ]; then
  echo "expected exactly one sealed bundle under $results_root, found $sealed_count" >&2
  exit 70
fi
status_json=$(find "$results_root" -mindepth 3 -maxdepth 3 -type f -name status.json)
bundle=$(dirname "$status_json")

echo "==> checking the sealed evidence"
if ! grep -q '"execution_status": "complete"' "$status_json"; then
  echo "the attempt did not seal as complete:" >&2
  grep -E '"(execution_status|failure_reason)"' "$status_json" >&2 || true
  exit 20
fi
if ! grep -q '"run_valid": true' "$bundle/classification.json"; then
  echo "the attempt sealed as invalid:" >&2
  cat "$bundle/classification.json" >&2
  exit 21
fi
for document in \
  experiment.source.toml experiment.resolved.json subjects.lock.json \
  environment.json execution-order.json classification.json comparison.json \
  checksums.txt bundle.json; do
  if [ ! -f "$bundle/$document" ]; then
    echo "the sealed bundle is missing $document" >&2
    exit 70
  fi
done

echo "==> verifying the checksums with the system tool"
if command -v shasum >/dev/null 2>&1; then
  (cd "$bundle" && shasum -a 256 -c checksums.txt >/dev/null)
elif command -v sha256sum >/dev/null 2>&1; then
  (cd "$bundle" && sha256sum -c checksums.txt >/dev/null)
else
  echo "neither shasum nor sha256sum is available to verify the bundle" >&2
  exit 70
fi

echo "bench-m0-acceptance: ok"
printf '%s\n' "$bundle"
