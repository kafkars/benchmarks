#!/usr/bin/env bash
# Executable architecture policy: zrail over the harness workspace, followed by
# the two repository-specific checks zrail deliberately cannot own.
#
# zrail owns the checked-in architecture, dependency edges, module contracts,
# declarative facades, sibling-test reachability, and file-size ratchets. The
# companion script reads the complete root Cargo.lock (zrail models declared
# edges, not the resolved transitive graph) and checks the detached subject
# adapter, whose reviewed path dependencies correctly escape this repository.
#
# The adapter's own lock is read only for the repository-wide criterion/divan
# ban. It remains exempt from the async-runtime ban: the adapter is a separate
# workspace built against the client under test, and the client brings whatever
# runtime graph it brings.
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

if ! command -v zrail >/dev/null 2>&1; then
  echo "check-guardrails: zrail 0.0.1 is required; install it with:" >&2
  echo "  cargo +1.96.0 install zrail --version 0.0.1 --locked" >&2
  exit 127
fi
zrail_version=$(zrail --version)
if [[ "$zrail_version" != "zrail 0.0.1" ]]; then
  echo "check-guardrails: expected zrail 0.0.1, found $zrail_version" >&2
  exit 1
fi

zrail check
scripts/check-detached-policy-test
scripts/check-detached-policy
