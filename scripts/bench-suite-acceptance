#!/usr/bin/env bash
# End-to-end acceptance for `benchctl suite`, against a real cluster.
#
# scripts/bench-m0-acceptance proves that one attempt of the balanced-1k
# scenario runs the two real adapters and seals a valid bundle. This script
# proves the next claim up: that three attempts of the same experiment aggregate
# into a suite summary, that the summary renders in both formats, and that the
# analysis packet derived from it round-trips through the guardrail that binds
# prose to it. None of that can be shown offline, because the offline fixture
# produces numbers a real client never would.
#
# It is deliberately not a cargo test: it needs Docker, a compiled librdkafka,
# and several minutes. The cluster is never started here — a harness that boots
# its own broker is a harness that measures its own startup.
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

bootstrap=${1:-127.0.0.1:39092,127.0.0.1:39093,127.0.0.1:39094}
repetitions=${2:-3}
# Cargo writes to CARGO_TARGET_DIR when it is set, so a script that hard-codes
# ./target looks for binaries cargo never put there. Everything below derives
# from this one variable for that reason.
target_dir=${CARGO_TARGET_DIR:-$repo_root/target}
mkdir -p "$target_dir"
work=$(mktemp -d "$target_dir/suite-acceptance.XXXXXX")
results_root="$work/results"
reports_root="$work/reports"
scenario="$repo_root/scenarios/producer/legacy-balanced-1k.toml"

echo "==> checking the cluster at $bootstrap"
first=${bootstrap%%,*}
host=${first%:*}
port=${first##*:}
if ! (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null; then
  echo "no broker is listening on $first" >&2
  echo "start one with:" >&2
  echo "  docker compose -f clusters/dev-compose/compose.yml up -d --wait" >&2
  exit 69
fi

# The subject list and cluster profile are written by the shared generator, so
# that this script and the nightly workflow measure the same pair of subjects
# against the same tools rather than two copies of one heredoc.
if [[ "$#" -gt 3 ]]; then
  echo "usage: scripts/bench-suite-acceptance [bootstrap] [repetitions] [qualified-candidate-checkout]" >&2
  exit 64
elif [[ "$#" -eq 3 ]]; then
  "$repo_root/scripts/generate-subject-config" "$work" "$bootstrap" "$3"
else
  "$repo_root/scripts/generate-subject-config" "$work" "$bootstrap"
fi
benchctl="$target_dir/release/benchctl"

echo "==> running $repetitions repetitions"
set +e
"$benchctl" suite \
  --experiment "$scenario" \
  --subjects "$work/subjects.toml" \
  --cluster "$work/cluster.toml" \
  --bootstrap "$bootstrap" \
  --results "$results_root" \
  --reports "$reports_root" \
  --repetitions "$repetitions"
suite_status=$?
set -e
if [ "$suite_status" -ne 0 ]; then
  echo "benchctl suite exited $suite_status; expected 0" >&2
  echo "every attempt must seal complete, and at least two must classify valid" >&2
  exit "$suite_status"
fi

echo "==> checking that every repetition sealed its own bundle"
sealed_count=$(find "$results_root" -mindepth 3 -maxdepth 3 -type f -name status.json | wc -l | tr -d ' ')
if [ "$sealed_count" != "$repetitions" ]; then
  echo "expected $repetitions sealed bundles under $results_root, found $sealed_count" >&2
  exit 70
fi

echo "==> checking that every repetition shares one experiment id"
experiment_dirs=$(find "$results_root" -mindepth 1 -maxdepth 1 -type d -not -name pending | wc -l | tr -d ' ')
if [ "$experiment_dirs" != "1" ]; then
  echo "the repetitions did not share one experiment id: found $experiment_dirs" >&2
  find "$results_root" -mindepth 1 -maxdepth 1 -type d >&2
  exit 70
fi

echo "==> checking that every repetition has its own run id"
run_ids=$(find "$results_root" -mindepth 3 -maxdepth 3 -type f -name experiment.resolved.json \
  -exec sed -n 's/.*"run_id": "\([0-9a-f]*\)".*/\1/p' {} + | sort -u | wc -l | tr -d ' ')
if [ "$run_ids" != "$repetitions" ]; then
  echo "expected $repetitions distinct run ids, found $run_ids" >&2
  exit 70
fi

echo "==> locating the suite reports"
summary=$(find "$reports_root" -type f -name suite-summary.json)
if [ "$(printf '%s\n' "$summary" | wc -l | tr -d ' ')" != "1" ] || [ -z "$summary" ]; then
  echo "expected exactly one suite-summary.json under $reports_root" >&2
  exit 70
fi
report_dir=$(dirname "$summary")
for document in report.md report.html analysis-packet.json; do
  if [ ! -s "$report_dir/$document" ]; then
    echo "the suite reports are missing a non-empty $document" >&2
    exit 70
  fi
done

echo "==> checking that the summary parses and names its repetitions"
if ! grep -q '"schema": "kafkars.suite-summary.v1"' "$summary"; then
  echo "$summary does not declare the suite summary schema" >&2
  exit 70
fi
if ! grep -q "\"repetitions\": $repetitions" "$summary"; then
  echo "$summary does not report $repetitions repetitions" >&2
  grep '"repetitions"' "$summary" >&2 || true
  exit 70
fi
if ! grep -q '"claim_eligible": false' "$summary"; then
  echo "$summary claims eligibility no document in this milestone may claim" >&2
  exit 70
fi

echo "==> checking the packet round-trips through the prose guardrail"
# The packet's verdict is deterministic, so a minimal summary that copies it and
# cites nothing is exactly the document the guardrail must accept; one that
# disagrees is exactly the document it must reject. Testing both directions is
# what makes the check a guardrail rather than a formality.
# awk with an explicit `exit` rather than `sed ... | head -n 1`: under the
# `set -o pipefail` in force here, head closing the pipe after the first line
# sends sed a SIGPIPE, and the resulting 141 fails the assignment and aborts the
# script for a read that actually succeeded.
verdict=$(awk 'match($0, /"verdict": *"[a-z_]+"/) {
    value = substr($0, RSTART, RLENGTH)
    sub(/^"verdict": *"/, "", value)
    sub(/"$/, "", value)
    print value
    exit
  }' "$report_dir/analysis-packet.json")
if [ -z "$verdict" ]; then
  echo "the analysis packet states no verdict" >&2
  exit 70
fi
cat >"$work/llm-summary.json" <<JSON
{
  "schema": "kafkars.llm-summary.v1",
  "verdict": "$verdict",
  "executive_summary": "Generated by scripts/bench-suite-acceptance to prove that a summary bound to this packet is accepted.",
  "findings": [],
  "hypotheses": [],
  "next_experiments": [],
  "caveats": ["This summary was written by a shell script and interprets nothing."]
}
JSON

"$benchctl" packet --suite "$summary" --llm-summary "$work/llm-summary.json"

wrong_verdict=invalid
if [ "$verdict" = "invalid" ]; then
  wrong_verdict=improved
fi
sed "s/\"verdict\": \"$verdict\"/\"verdict\": \"$wrong_verdict\"/" \
  "$work/llm-summary.json" >"$work/llm-summary-wrong.json"
set +e
"$benchctl" packet --suite "$summary" --llm-summary "$work/llm-summary-wrong.json" >/dev/null 2>&1
wrong_status=$?
set -e
if [ "$wrong_status" != "65" ]; then
  echo "a summary that overrules the packet's verdict exited $wrong_status; expected 65" >&2
  exit 70
fi

echo "==> rendering one repetition's bundle on its own"
# -print -quit stops find at the first hit inside find itself, so there is no
# pipe for `head` to close and no SIGPIPE for pipefail to turn into a failure.
bundle=$(dirname "$(find "$results_root" \
  -mindepth 3 -maxdepth 3 -type f -name status.json -print -quit)")
"$benchctl" report --bundle "$bundle" --out "$work/bundle-report.md"
if [ ! -s "$work/bundle-report.md" ]; then
  echo "benchctl report wrote nothing for $bundle" >&2
  exit 70
fi

echo "==> verifying every bundle's checksums with the system tool"
# -print0 into a read loop rather than word splitting over $(find ...): the
# unquoted form re-splits on whitespace, so one results root under a path with a
# space in it would silently check a directory that does not exist and pass.
while IFS= read -r -d '' status_json; do
  sealed=$(dirname "$status_json")
  if command -v shasum >/dev/null 2>&1; then
    (cd "$sealed" && shasum -a 256 -c checksums.txt >/dev/null)
  elif command -v sha256sum >/dev/null 2>&1; then
    (cd "$sealed" && sha256sum -c checksums.txt >/dev/null)
  else
    echo "neither shasum nor sha256sum is available to verify the bundles" >&2
    exit 70
  fi
done < <(find "$results_root" -mindepth 3 -maxdepth 3 -type f -name status.json -print0)

if [[ "$#" -eq 3 ]]; then
  python3 "$repo_root/scripts/prepare-qualified-candidate" verify-bundles \
    --directory "$work" --results "$results_root" --expected "$repetitions" --seal
  python3 "$repo_root/scripts/prepare-qualified-candidate" verify-bundles \
    --directory "$work" --results "$results_root" --expected "$repetitions"
fi

echo "bench-suite-acceptance: ok"
printf '%s\n' "$report_dir"
