#!/usr/bin/env bash
# The single gate. Everything a reviewer is entitled to assume about a change in
# this repository is checked here, in the order that fails fastest and cheapest.
#
# What this gate deliberately does NOT prove: adapter builds and cross-language
# conformance (scripts/check-benchmarks — needs sibling checkouts and a built
# librdkafka), and any real-broker behavior (scripts/bench-m0-acceptance —
# needs the dev compose cluster). Run those when touching adapters or the
# supervisor's broker-facing seams.
#
# Every lane below runs on a clean clone with no sibling checkouts beside it.
# That is a property worth keeping: provenance is advisory locally and reports
# absent siblings as a warning rather than a failure, so somebody who has just
# cloned this one repository can still run the gate and get a real answer.
# Strict provenance — the mode that refuses absent or mismatched siblings — is
# CI's job and the release procedure's; see RELEASING.md.
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

# benchmark-openai-summary-test is in the list despite not being named check-*:
# it is an offline script contract that needs only python3, CI runs it in the
# control-plane lane, and a gate that skipped it would let a change to the
# prompt artifact or the summary script pass locally and fail there.
for lane in check-workspace check-guardrails check-schemas check-librdkafka-pin check-control-plane \
  benchmark-openai-summary-test check-dependency-provenance; do
  echo "==> $lane"
  "$repo_root/scripts/$lane"
done

echo "check: ok"
