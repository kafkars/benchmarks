#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
manifest="$repo_root/adapters/kafkars/Cargo.toml"
binary_root=$("$repo_root/scripts/build-benchmark-adapters" "$@")
if [[ "$#" -ne 0 ]]; then
  manifest=$(python3 - "$binary_root/candidate-provenance.json" <<'PY'
import json, sys
with open(sys.argv[1]) as source:
    print(json.load(source)["adapter_manifest_path"])
PY
  )
fi
run_id=0123456789abcdef
export CARGO_TARGET_DIR="$repo_root/target/benchmarks/kafkars-check"

# The same Node floor scripts/check-control-plane enforces, for the same reason
# and against the same test suite. Without it, an old runtime fails partway
# through `node --test` with a parse error inside a test file, which reads as a
# broken legacy module rather than as "your Node is too old" — and here it would
# do so only after the adapter build above has already spent several minutes.
# The floor matches the engines range in package.json; changing one without the
# other makes the declaration a lie.
required_major=22
required_minor=18

if ! command -v node >/dev/null 2>&1; then
  echo "check-benchmarks: node was not found on PATH;" \
    "the legacy control plane requires Node >= $required_major.$required_minor" >&2
  exit 1
fi

node_version=$(node --version)
numeric=${node_version#v}
major=${numeric%%.*}
remainder=${numeric#*.}
minor=${remainder%%.*}

if [[ ! "$major" =~ ^[0-9]+$ ]] || [[ ! "$minor" =~ ^[0-9]+$ ]]; then
  echo "check-benchmarks: could not parse the node version '$node_version'" >&2
  exit 1
fi

if ((major < required_major)) ||
  ((major == required_major && minor < required_minor)); then
  echo "check-benchmarks: node $node_version is too old;" \
    "the legacy control plane requires Node >= $required_major.$required_minor" >&2
  exit 1
fi

node --test "$repo_root/legacy/benchctl/"*.test.mjs
cargo fmt --manifest-path "$manifest" --all -- --check
cargo clippy \
  --manifest-path "$manifest" \
  --locked \
  --offline \
  --all-targets \
  -- -D warnings
cargo test \
  --manifest-path "$manifest" \
  --locked \
  --offline

for sequence in 0 1 42 18446744073709551615; do
  rust_vector=$(
    "$binary_root/kafkars-benchmark-adapter" payload "$run_id" "$sequence" 1024
  )
  c_vector=$(
    "$binary_root/librdkafka-payload-vector" "$run_id" "$sequence" 1024
  )
  if [[ "$rust_vector" != "$c_vector" ]]; then
    echo "payload conformance failed at sequence $sequence" >&2
    exit 1
  fi
done

for vector in "100000 1000 256 4" "3 17 4 2" "1000000000 513 256 4"; do
  read -r rate records batch_records callers <<<"$vector"
  rust_vector=$(
    "$binary_root/kafkars-benchmark-adapter" schedule \
      "$rate" "$records" "$batch_records" "$callers"
  )
  c_vector=$(
    "$binary_root/librdkafka-schedule-vector" \
      "$rate" "$records" "$batch_records" "$callers"
  )
  if [[ "$rust_vector" != "$c_vector" ]]; then
    echo "schedule conformance failed for $vector" >&2
    exit 1
  fi
done

# The loops above prove the two adapters agree with each other today. They cannot
# prove either one still agrees with what shipped, because a change that moves
# both implementations in lockstep keeps them equal while silently redefining the
# payload bytes or the admission schedule. The committed goldens under
# conformance/ are the third party to that comparison: they pin the bytes across
# time, so the assertion below turns Rust == C into Rust == C == shipped.
golden_root="$repo_root/conformance"
vector_scratch=$(mktemp -d)
trap 'rm -rf -- "$vector_scratch"' EXIT

assert_golden() {
  local golden="$1"
  local observed="$2"
  local producer="$3"
  local doc="${4:-conformance/README.md}"
  if [[ ! -f "$golden" ]]; then
    echo "missing conformance golden ${golden#"$repo_root/"}" >&2
    echo "regenerate the goldens with the commands in $doc" >&2
    exit 1
  fi
  if ! cmp -s "$golden" "$observed"; then
    echo "conformance golden mismatch: $producer disagrees with" >&2
    echo "  ${golden#"$repo_root/"}" >&2
    echo "the observable vector bytes changed; if that is intended, regenerate" >&2
    echo "the goldens with the commands in $doc and review the" >&2
    echo "resulting diff as a behavior change, not a refresh" >&2
    exit 1
  fi
}

for sequence in 0 1 42 18446744073709551615; do
  golden="$golden_root/payload/seq-$sequence.vector"
  "$binary_root/kafkars-benchmark-adapter" payload "$run_id" "$sequence" 1024 \
    >"$vector_scratch/payload-rust.vector"
  "$binary_root/librdkafka-payload-vector" "$run_id" "$sequence" 1024 \
    >"$vector_scratch/payload-c.vector"
  assert_golden \
    "$golden" "$vector_scratch/payload-rust.vector" "kafkars payload $sequence"
  assert_golden \
    "$golden" "$vector_scratch/payload-c.vector" "librdkafka payload $sequence"
done

for vector in "100000 1000 256 4" "3 17 4 2" "1000000000 513 256 4"; do
  read -r rate records batch_records callers <<<"$vector"
  golden="$golden_root/schedule/$rate-$records-$batch_records-$callers.vector"
  "$binary_root/kafkars-benchmark-adapter" schedule \
    "$rate" "$records" "$batch_records" "$callers" \
    >"$vector_scratch/schedule-rust.vector"
  "$binary_root/librdkafka-schedule-vector" \
    "$rate" "$records" "$batch_records" "$callers" \
    >"$vector_scratch/schedule-c.vector"
  assert_golden \
    "$golden" "$vector_scratch/schedule-rust.vector" "kafkars schedule $vector"
  assert_golden \
    "$golden" "$vector_scratch/schedule-c.vector" "librdkafka schedule $vector"
done

# The third cross-language contract: the log-linear histogram encoding every
# reader derives percentiles from. Unlike the two above there is no direct
# Rust-versus-C comparison here, because holding both to the same committed
# golden is strictly stronger than holding them to each other.
histogram_doc="conformance/histogram/README.md"
histogram_input="$golden_root/histogram/mixed.input"
histogram_golden="$golden_root/histogram/mixed.vector"
histogram_c="$binary_root/librdkafka-histogram-vector"
if [[ ! -f "$histogram_input" ]]; then
  echo "missing conformance input ${histogram_input#"$repo_root/"}" >&2
  exit 1
fi
if [[ ! -x "$histogram_c" ]]; then
  echo "missing built binary librdkafka-histogram-vector" >&2
  echo "the histogram encoding is a byte contract between two languages, and a" >&2
  echo "check that only ran the Rust side would assert that a value equals" >&2
  echo "itself. Build the C vector binary from the librdkafka adapter — it" >&2
  echo "reads the same whitespace-separated u64 values on standard input and" >&2
  echo "prints the same compact JSON — and add it to" >&2
  echo "scripts/build-benchmark-adapters next to librdkafka-schedule-vector." >&2
  echo "See $histogram_doc for what the vector covers." >&2
  exit 1
fi
"$binary_root/kafkars-benchmark-adapter" histogram-vector \
  <"$histogram_input" \
  >"$vector_scratch/histogram-rust.vector"
"$histogram_c" <"$histogram_input" >"$vector_scratch/histogram-c.vector"
assert_golden \
  "$histogram_golden" "$vector_scratch/histogram-rust.vector" \
  "kafkars histogram-vector" "$histogram_doc"
assert_golden \
  "$histogram_golden" "$vector_scratch/histogram-c.vector" \
  "librdkafka histogram-vector" "$histogram_doc"
