#!/usr/bin/env python3
"""Bind the registry adapter to its reviewed source and locked archive closure.

Registry manifests and lock identity always fail closed. Clean source checkout
correspondence is strict in CI and advisory locally. --archives additionally
verifies the fetched .crate bytes and their embedded, clean VCS identities.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tarfile
import tomllib


ROOT = Path(__file__).resolve().parent.parent
REGISTRY = "registry+https://github.com/rust-lang/crates.io-index"
FAMILIES = {
    "KAFKARS_REVISION": ("0.0.2-rc.2", ("kafkars", "kafka-client-core", "kafka-client-engine")),
    "KAFKA_DRIVER_REVISION": (
        "0.1.0-rc.7", ("kafka-driver", "kafka-driver-core", "kafka-driver-transport")
    ),
    "KAFKA_PROTOCOL_REVISION": (
        "0.1.0-rc.3", ("kafka-wire", "kafka-wire-core", "kafka-wire-records")
    ),
}


def revisions(text: str) -> dict[str, str]:
    lines = [line for line in text.splitlines() if line and not line.startswith("#")]
    if len(lines) != len(FAMILIES):
        raise ValueError("revision file must contain exactly three assignments")
    pins = {}
    for key, line in zip(FAMILIES, lines, strict=True):
        match = re.fullmatch(rf"{key}=([0-9a-f]{{40}})", line)
        if match is None:
            raise ValueError(f"invalid {key} assignment")
        pins[key] = match[1]
    return pins


def registry_packages(manifest: dict, lock: dict) -> dict[str, dict]:
    if manifest["dependencies"]["kafkars"] != "=0.0.2-rc.2":
        raise ValueError("adapter must use the exact published RC.2, not a path or Git override")
    if manifest.get("patch") or manifest.get("replace"):
        raise ValueError("adapter registry patches and replacements are forbidden")
    expected = {name: version for version, names in FAMILIES.values() for name in names}
    found = {}
    for package in lock.get("package", []):
        name = package["name"]
        if name not in expected:
            continue
        if name in found or package["version"] != expected[name]:
            raise ValueError(f"unexpected or duplicate registry version for {name}")
        if package.get("source") != REGISTRY:
            raise ValueError(f"{name} is not a crates.io dependency")
        if re.fullmatch(r"[0-9a-f]{64}", package.get("checksum", "")) is None:
            raise ValueError(f"{name} is missing its canonical archive checksum")
        found[name] = package
    if set(found) != set(expected):
        raise ValueError(f"missing registry packages: {sorted(set(expected) - set(found))}")
    return found


def git(path: Path, *args: str) -> str:
    result = subprocess.run(
        ["git", "-C", str(path), *args], check=True, capture_output=True, text=True
    )
    return result.stdout.strip()


def source_correspondence(pins: dict[str, str], packages: dict[str, dict]) -> list[str]:
    paths = {
        "KAFKARS_REVISION": Path(os.environ.get("KAFKA_BENCH_CLIENT_ROOT", ROOT.parent / "kafkars")),
        "KAFKA_DRIVER_REVISION": Path(os.environ.get("KAFKA_BENCH_DRIVER_ROOT", ROOT.parent / "kafka-driver")),
        "KAFKA_PROTOCOL_REVISION": Path(os.environ.get("KAFKA_BENCH_PROTOCOL_ROOT", ROOT.parent / "kafka-protocol")),
    }
    failures = []
    for key, path in paths.items():
        try:
            if git(path, "rev-parse", "HEAD") != pins[key]:
                raise ValueError(f"{path.name} is not at {pins[key]}")
            if git(path, "status", "--porcelain=v1", "--untracked-files=all"):
                raise ValueError(f"{path.name} has unreviewed working-tree changes")
            if any(not line.startswith("H ") for line in git(path, "ls-files", "-v", "-f").splitlines()):
                raise ValueError(f"{path.name} has noncanonical index flags")
            if key == "KAFKARS_REVISION":
                source_lock = tomllib.loads(git(path, "show", f"{pins[key]}:Cargo.lock"))
                source_packages = {item["name"]: item for item in source_lock["package"]}
                for name, package in packages.items():
                    source = source_packages.get(name, {})
                    if source.get("version") != package["version"]:
                        raise ValueError(f"source and registry disagree on {name} version")
                    # Native packages are paths in their source workspace; its
                    # published driver/wire closure must match byte-for-byte.
                    if name.startswith(("kafka-driver", "kafka-wire")) and (
                        source.get("source") != REGISTRY or source.get("checksum") != package["checksum"]
                    ):
                        raise ValueError(f"source and registry disagree on {name} archive")
        except (OSError, subprocess.CalledProcessError, ValueError) as error:
            failures.append(f"{key}: {error}")
    return failures


def check_archives(cache: Path, pins: dict[str, str], packages: dict[str, dict]) -> None:
    for key, (_, names) in FAMILIES.items():
        for name in names:
            package = packages[name]
            stem = f"{name}-{package['version']}"
            matches = list(cache.glob(f"*/{stem}.crate"))
            if len(matches) != 1:
                raise ValueError(f"expected exactly one cached archive for {stem}")
            archive = matches[0]
            with archive.open("rb") as source:
                digest = hashlib.file_digest(source, "sha256").hexdigest()
            if digest != package["checksum"]:
                raise ValueError(f"archive checksum mismatch for {stem}")
            with tarfile.open(archive, "r:gz") as contents:
                member = contents.extractfile(f"{stem}/.cargo_vcs_info.json")
                if member is None:
                    raise ValueError(f"missing VCS identity for {stem}")
                vcs = json.load(member)
            if vcs["git"]["sha1"] != pins[key] or vcs["git"].get("dirty", False):
                raise ValueError(f"unreviewed VCS identity for {stem}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--archives", type=Path, help="Cargo registry/cache directory")
    args = parser.parse_args()
    try:
        pins = revisions((ROOT / "dependencies/sibling-revisions.env").read_text())
        manifest = tomllib.loads((ROOT / "adapters/kafkars/Cargo.toml").read_text())
        lock = tomllib.loads((ROOT / "adapters/kafkars/Cargo.lock").read_text())
        packages = registry_packages(manifest, lock)
        failures = source_correspondence(pins, packages)
        strict = os.environ.get("CI") == "true" or os.environ.get("KAFKA_BENCH_PROVENANCE") == "strict"
        for failure in failures:
            print(f"provenance {'failure' if strict else 'advisory'}: {failure}", file=sys.stderr)
        if args.archives is not None:
            check_archives(args.archives, pins, packages)
        if strict and failures:
            return 1
        print(f"provenance: {len(packages)} exact registry packages; source correspondence {'unchecked' if failures else 'verified'}")
        return 0
    except (OSError, ValueError, KeyError, tarfile.TarError) as error:
        print(f"provenance failure: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
