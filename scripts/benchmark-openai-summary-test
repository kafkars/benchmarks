      "denominator_subject": "librdkafka-c",
      "metric": "p99_admission_wait_ns",
      "numerator_subject": "kafkars",
      "ratio_of_medians": 1.0
    },
    {
      "ci_high": 1.0,
      "ci_low": 1.0,
      "denominator_subject": "librdkafka-c",
      "metric": "cpu_core_seconds",
      "numerator_subject": "kafkars",
      "ratio_of_medians": 1.0
    },
    {
      "ci_high": 1.0,
      "ci_low": 1.0,
      "denominator_subject": "librdkafka-c",
      "metric": "max_rss_bytes",
      "numerator_subject": "kafkars",
      "ratio_of_medians": 1.0
    }
  ],
  "practical_threshold": 0.05,
  "repetitions": 2,
  "resamples": 50000,
  "scenario_name": "producer-balanced-1k-diagnostic",
  "schema": "kafkars.suite-summary.v1",
  "seed": 44
}
JSON

echo "==> a dry run writes the request and nothing else"
scripts/benchmark-openai-summary --reports "$reports" --dry-run >"$work/stdout.log"

request="$reports/llm-summary-request.json"
[[ -f "$request" ]] || fail "the dry run did not write $request"
[[ ! -e "$reports/llm-summary.json" ]] \
  || fail "the dry run wrote a summary nothing validated"
[[ ! -e "$reports/llm-summary.md" ]] \
  || fail "the dry run rendered markdown for a summary that does not exist"
[[ ! -e "$reports/llm-provenance.json" ]] \
  || fail "the dry run wrote provenance for a call it never made"

echo "==> the request states the reviewed prompt, model, effort, and digest"
python3 - "$request" "$reports/analysis-packet.json" \
  "$repo_root/analysis/prompts/producer-comparison.v1.md" <<'PY'
import hashlib
import json
import pathlib
import sys

request_path, packet_path, prompt_path = (pathlib.Path(part) for part in sys.argv[1:4])
document = json.loads(request_path.read_text(encoding="utf-8"))
packet_bytes = packet_path.read_bytes()
problems = []


def require(condition, message):
    if not condition:
        problems.append(message)


require(
    document["promptVersion"] == "producer-comparison.v1",
    f"promptVersion is {document['promptVersion']!r}, not the committed prompt version",
)
require(
    prompt_path.name == f"{document['promptVersion']}.md",
    "promptVersion does not name the prompt file the script reads",
)
require(
    document["model"] == "gpt-5.5",
    f"the default model is {document['model']!r}, not gpt-5.5",
)
require(
    document["reasoningEffort"] == "high",
    f"the default reasoning effort is {document['reasoningEffort']!r}, not high",
)
require(
    document["inputSha256"] == hashlib.sha256(packet_bytes).hexdigest(),
    "inputSha256 is not the digest of the packet bytes the script read",
)

request = document["request"]
require(request["model"] == document["model"], "the payload model disagrees with the record")
require(
    request["reasoning"]["effort"] == document["reasoningEffort"],
    "the payload reasoning effort disagrees with the record",
)

fmt = request["text"]["format"]
require(fmt["type"] == "json_schema", "the reply is not constrained by a json schema")
require(
    fmt["name"] == "kafkars_llm_summary",
    f"the structured output is named {fmt['name']!r}, not kafkars_llm_summary",
)
require(fmt["strict"] is True, "the structured output is not strict")

# The schema must mirror kafkars.llm-summary.v1 exactly. A schema that allowed
# one extra property would produce replies that LlmSummary's deny_unknown_fields
# rejects, which is a guardrail failure the model could not have avoided.
schema = fmt["schema"]
seven = [
    "schema",
    "verdict",
    "executive_summary",
    "findings",
    "hypotheses",
    "next_experiments",
    "caveats",
]
require(schema["additionalProperties"] is False, "the schema admits unknown properties")
require(sorted(schema["required"]) == sorted(seven), "the schema does not require all seven fields")
require(sorted(schema["properties"]) == sorted(seven), "the schema does not define exactly the seven fields")
require(
    schema["properties"]["schema"]["enum"] == ["kafkars.llm-summary.v1"],
    "the schema id is not pinned as a single-value enum, so the model may omit or invent one",
)
require(
    schema["properties"]["verdict"]["enum"]
    == ["improved", "regressed", "mixed", "inconclusive", "invalid"],
    "the verdict enumeration does not match the packet vocabulary",
)
for field, required_keys in (
    ("findings", ["text", "metric_refs", "evidence_refs"]),
    ("hypotheses", ["text", "confidence", "evidence_refs"]),
):
    items = schema["properties"][field]["items"]
    require(items["additionalProperties"] is False, f"{field} items admit unknown properties")
    require(sorted(items["required"]) == sorted(required_keys), f"{field} items require the wrong keys")
    require(sorted(items["properties"]) == sorted(required_keys), f"{field} items define the wrong keys")
require(
    schema["properties"]["hypotheses"]["items"]["properties"]["confidence"]["enum"]
    == ["low", "medium", "high"],
    "the confidence enumeration does not match kafkars.llm-summary.v1",
)

# The two messages are the reviewed prompt, split at its own headings, with the
# packet injected verbatim. A request whose text is not this file's text would
# make the prompt version a label rather than a fact.
system_text = request["input"][0]["content"][0]["text"]
user_text = request["input"][1]["content"][0]["text"]
prompt_text = prompt_path.read_text(encoding="utf-8")
require(request["input"][0]["role"] == "system", "the first message is not the system message")
require(request["input"][1]["role"] == "user", "the second message is not the user message")
require(system_text.startswith("## Prompt"), "the system message is not the prompt section")
require(system_text in prompt_text, "the system message is not verbatim from the prompt file")
require(user_text.startswith("### The packet"), "the user message is not the packet section")
require("{{ANALYSIS_PACKET_JSON}}" not in user_text, "the packet slot was never filled")
require(
    packet_bytes.decode("utf-8").rstrip("\n") in user_text,
    "the packet the digest covers is not the packet the model is sent",
)

# The guardrail instructions are the reason this prompt is versioned. Losing any
# of them would leave a summary that validates against its packet and still
# misrepresents it.
for phrase, why in (
    ("**Copy the verdict.**", "the verdict must be copied, never concluded"),
    ("**Do not restate numbers; cite them.**", "quantities must be cited by packet key"),
    ("must exist in the packet's `metrics`", "metric_refs must resolve in the packet"),
    ("**Causality is a hypothesis, never a finding.**", "mechanism claims must be hypotheses"),
    ("**Report the anomalies.**", "anomalies must reach the reader"),
    ("**No marketing.**", "this is diagnostic evidence, not advocacy"),
    ("**Do not touch validity.**", "validity is the packet's to state"),
    ("not claim-eligible", "no summary may imply a publishable claim"),
    ("**Name both sides of every comparison.**", "a ratio with an unnamed denominator is decoration"),
):
    require(phrase in system_text, f"the prompt no longer says {phrase!r}: {why}")

if problems:
    for problem in problems:
        print(f"error: {problem}", file=sys.stderr)
    raise SystemExit(1)
PY

echo "==> the rendered banner is the one bench-report renders"
python3 - "$repo_root/crates/bench-report/src/render.rs" \
  "$repo_root/scripts/benchmark-openai-summary" <<'PY'
import ast
import pathlib
import re
import sys

render_rs, script = (pathlib.Path(part).read_text(encoding="utf-8") for part in sys.argv[1:3])
rust = re.search(
    r'pub const DIAGNOSTIC_BANNER: &str = ("(?:[^"\\]|\\.)*");', render_rs, re.S
)
if rust is None:
    raise SystemExit("error: bench_report::DIAGNOSTIC_BANNER could not be read")
# Undo Rust's line-continuation escape, which strips the newline and the
# indentation that follows it.
expected = re.sub(r"\\\s*\n\s*", "", rust.group(1)[1:-1])

# The script's copy is read as a Python literal rather than searched for as a
# substring, so it may be wrapped across lines the way the rest of the file is.
python = re.search(r"DIAGNOSTIC_BANNER = (\([^)]*\))", script, re.S)
if python is None:
    raise SystemExit("error: the summary script no longer defines DIAGNOSTIC_BANNER")
actual = ast.literal_eval(python.group(1))
if actual != expected:
    raise SystemExit(
        "error: the summary script's diagnostic banner has drifted from "
        f"bench_report::DIAGNOSTIC_BANNER.\n  render.rs: {expected}\n  script:    {actual}"
    )
PY

echo "==> a missing packet is refused rather than narrated"
mkdir -p "$work/empty"
if scripts/benchmark-openai-summary --reports "$work/empty" --dry-run >/dev/null 2>&1; then
  fail "a reports directory with no analysis packet was accepted"
fi

echo "==> a non-default model and effort reach the request"
scripts/benchmark-openai-summary \
  --reports "$reports" \
  --model gpt-5.5-mini \
  --reasoning-effort medium \
  --dry-run >/dev/null
python3 - "$request" <<'PY'
import json
import pathlib
import sys

document = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
if document["model"] != "gpt-5.5-mini" or document["reasoningEffort"] != "medium":
    raise SystemExit(f"error: --model and --reasoning-effort did not reach the request: {document['model']} {document['reasoningEffort']}")
PY

echo "==> a replayed reply lands with its provenance embedded, and renders nothing"
# The one path that exercises the reply handling with no network and no key.
# The reply deliberately states a verdict the packet does not, so the outcome is
# the same wherever this runs: where a benchctl exists the guardrail rejects the
# summary, where none exists it cannot spawn, and both are nonzero with no
# markdown. That is the invariant worth pinning — prose is rendered only for a
# summary something checked — and the embed is asserted beside it.
replay="$work/reply.json"
python3 - "$replay" <<'PY'
import json
import pathlib
import sys

summary = {
    "schema": "kafkars.llm-summary.v1",
    "verdict": "improved",
    "executive_summary": (
        "A fixed reply, so the contract test exercises the reply path without a "
        "network. Its verdict disagrees with the packet on purpose."
    ),
    "findings": [],
    "hypotheses": [],
    "next_experiments": [],
    "caveats": ["Written by a contract test; it interprets nothing."],
}
pathlib.Path(sys.argv[1]).write_text(
    json.dumps({"id": "resp_offline_contract_test", "output_text": json.dumps(summary)}, indent=2),
    encoding="utf-8",
)
PY

replay_out="$work/replay"
mkdir -p "$replay_out"
if scripts/benchmark-openai-summary \
  --reports "$reports" \
  --output-json "$replay_out/llm-summary.json" \
  --offline-reply "$replay" \
  --dry-run >/dev/null 2>&1; then
  fail "--dry-run and --offline-reply were accepted together"
fi

set +e
scripts/benchmark-openai-summary \
  --reports "$reports" \
  --output-json "$replay_out/llm-summary.json" \
  --output-markdown "$replay_out/llm-summary.md" \
  --offline-reply "$replay" >"$work/replay.log" 2>&1
replay_status=$?
set -e

if [ "$replay_status" -eq 0 ]; then
  fail "a summary that overrules the packet's verdict was accepted"
fi
[[ -f "$replay_out/llm-summary.json" ]] \
  || fail "the replay did not write a summary: $(cat "$work/replay.log")"
[[ -f "$replay_out/llm-provenance.json" ]] \
  || fail "the replay did not keep the provenance sidecar"
[[ ! -e "$replay_out/llm-summary.md" ]] \
  || fail "markdown was rendered for a summary the guardrail never accepted"

python3 - "$replay_out/llm-summary.json" "$replay_out/llm-provenance.json" \
  "$reports/analysis-packet.json" <<'PY'
import hashlib
import json
import pathlib
import sys

summary_path, sidecar_path, packet_path = (pathlib.Path(part) for part in sys.argv[1:4])
summary = json.loads(summary_path.read_text(encoding="utf-8"))
sidecar = json.loads(sidecar_path.read_text(encoding="utf-8"))

embedded = summary.get("provenance")
if embedded is None:
    raise SystemExit("error: the summary carries no embedded provenance")
if embedded != sidecar:
    raise SystemExit(
        "error: the embedded provenance and the sidecar disagree.\n"
        f"  embedded: {embedded}\n  sidecar:  {sidecar}"
    )
for field in (
    "model",
    "prompt_version",
    "reasoning_effort",
    "response_id",
    "input_sha256",
    "output_sha256",
    "created_at",
):
    if not embedded.get(field):
        raise SystemExit(f"error: the embedded provenance has no {field}")
if embedded["prompt_version"] != "producer-comparison.v1":
    raise SystemExit("error: the embedded prompt version is not the committed one")
if embedded["response_id"] != "resp_offline_contract_test":
    raise SystemExit("error: the response id did not come from the reply")
if embedded["input_sha256"] != hashlib.sha256(packet_path.read_bytes()).hexdigest():
    raise SystemExit("error: input_sha256 is not the digest of the packet that was sent")

# The digest covers the model's own bytes, before the provenance block was
# added, because a digest cannot cover the field that carries it. Dropping the
# field and rehashing is exactly what a reader checking this document does, so
# the test does it too.
del summary["provenance"]
recomputed = hashlib.sha256((json.dumps(summary, indent=2) + "\n").encode("utf-8")).hexdigest()
if recomputed != embedded["output_sha256"]:
    raise SystemExit(
        "error: output_sha256 does not cover the summary with the provenance removed"
    )
PY

echo "==> the model is never asked to write its own provenance"
python3 - "$request" <<'PY'
import json
import pathlib
import sys

schema = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))["request"]["text"][
    "format"
]["schema"]
if "provenance" in schema["properties"] or "provenance" in schema["required"]:
    raise SystemExit(
        "error: the strict output schema offers the model a provenance field. "
        "Provenance is stamped by the script from what it actually did; a model "
        "that could write it could write anything."
    )
PY

printf 'benchmark-openai-summary contract test passed\n'
