#!/usr/bin/env bash
# Offline contract test for scripts/benchmark-openai-summary. No network, no
# API key, no cargo, no cluster: python3 and bash are the whole dependency set,
# which is why this runs in CI's control-plane lane on every pull request.
#
# What it proves is that the request the script would send is the request the
# reviewed prompt describes — the committed prompt version, the model and effort
# defaults, the digest of the exact packet bytes, and a strict structured-output
# schema that mirrors kafkars.llm-summary.v1 field for field. It also proves the
# thing a dry run must NOT do: write a summary. A --dry-run that left an
# llm-summary.json behind would have written prose nothing validated, which is
# the one outcome this pipeline exists to make impossible.
#
# It cannot prove that a model replies well, and does not try. That is what the
# guardrail is for, and the guardrail is `benchctl packet`, which has its own
# tests.
#
# The fixture below is real. It is the suite summary and analysis packet a
# two-repetition offline suite produced against the fake-adapter fixture — the
# same path crates/benchctl/tests/suite_capacity.rs drives — captured once and
# committed here so that this test needs no build:
#
#   benchctl suite --experiment scenarios/producer/legacy-balanced-1k.toml \
#     --subjects <fake-adapter subjects> --cluster <fake-adapter cluster> \
#     --bootstrap 127.0.0.1:39092,127.0.0.1:39093,127.0.0.1:39094 \
#     --repetitions 2
#
# Regenerate it the same way if the packet's shape ever changes; hand-editing it
# would turn a fixture that mirrors the engine into one that mirrors a guess.
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

work="$repo_root/target/benchmark-openai-summary-test"
reports="$work/reports"

fail() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

rm -rf "$work"
mkdir -p "$reports"

cat >"$reports/analysis-packet.json" <<'JSON'
