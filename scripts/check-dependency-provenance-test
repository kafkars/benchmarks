#!/usr/bin/env python3
"""Negative tests for registry/source identity; no broker or network required."""

import copy
import hashlib
import importlib.machinery
import importlib.util
import io
import json
from pathlib import Path
import sys
import tarfile
import tempfile
import unittest

sys.dont_write_bytecode = True

path = Path(__file__).with_name("check-dependency-provenance")
loader = importlib.machinery.SourceFileLoader("provenance", str(path))
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)


class ProvenanceTest(unittest.TestCase):
    def setUp(self):
        self.manifest = {"dependencies": {"kafkars": "=0.0.2-rc.2"}}
        self.lock = {"package": [
            {"name": name, "version": version, "source": module.REGISTRY, "checksum": "a" * 64}
            for version, names in module.FAMILIES.values() for name in names
        ]}
        self.pins = {key: "b" * 40 for key in module.FAMILIES}

    def test_exact_registry_closure_is_accepted(self):
        self.assertEqual(len(module.registry_packages(self.manifest, self.lock)), 9)

    def test_path_or_git_client_cannot_replace_registry_client(self):
        for override in [{"path": "../client"}, {"git": "https://example.invalid/client"}, "0.0.2"]:
            with self.subTest(override=override), self.assertRaises(ValueError):
                module.registry_packages({"dependencies": {"kafkars": override}}, self.lock)

    def test_patch_and_replace_are_rejected(self):
        for key in ["patch", "replace"]:
            with self.subTest(key=key), self.assertRaises(ValueError):
                module.registry_packages({**self.manifest, key: {"kafkars": {}}}, self.lock)

    def test_missing_or_duplicate_native_package_is_rejected(self):
        for packages in [self.lock["package"][:-1], self.lock["package"] * 2]:
            with self.subTest(count=len(packages)), self.assertRaises(ValueError):
                module.registry_packages(self.manifest, {"package": packages})

    def test_version_source_and_checksum_are_all_required(self):
        for key, value in [("version", "0.0.2-rc.1"), ("source", "git+fake"), ("checksum", "z" * 64)]:
            lock = copy.deepcopy(self.lock)
            lock["package"][0][key] = value
            with self.subTest(key=key), self.assertRaises(ValueError):
                module.registry_packages(self.manifest, lock)

    def test_revision_order_and_exact_sha_are_required(self):
        valid = "\n".join(f"{key}={value}" for key, value in self.pins.items())
        self.assertEqual(module.revisions(valid), self.pins)
        for invalid in [valid + "\nEXTRA=" + "b" * 40, valid.replace("b" * 40, "b" * 7), "\n".join(reversed(valid.splitlines()))]:
            with self.subTest(invalid=invalid), self.assertRaises(ValueError):
                module.revisions(invalid)

    def archives(self, cache, dirty=False, revision=None):
        directory = cache / "canonical-registry"
        directory.mkdir()
        packages = copy.deepcopy(module.registry_packages(self.manifest, self.lock))
        for key, (_, names) in module.FAMILIES.items():
            for name in names:
                package = packages[name]
                stem = f"{name}-{package['version']}"
                archive = directory / f"{stem}.crate"
                vcs = json.dumps({"git": {"sha1": revision or self.pins[key], "dirty": dirty}}).encode()
                with tarfile.open(archive, "w:gz") as contents:
                    member = tarfile.TarInfo(f"{stem}/.cargo_vcs_info.json")
                    member.size = len(vcs)
                    contents.addfile(member, io.BytesIO(vcs))
                package["checksum"] = hashlib.sha256(archive.read_bytes()).hexdigest()
        return packages

    def test_clean_archives_match_exact_source_identity(self):
        with tempfile.TemporaryDirectory() as temporary:
            cache = Path(temporary)
            packages = self.archives(cache)
            module.check_archives(cache, self.pins, packages)

    def test_tampered_archive_is_rejected(self):
        with tempfile.TemporaryDirectory() as temporary:
            cache = Path(temporary)
            packages = self.archives(cache)
            packages["kafkars"]["checksum"] = "a" * 64
            with self.assertRaises(ValueError):
                module.check_archives(cache, self.pins, packages)

    def test_dirty_or_other_source_archive_is_rejected(self):
        for dirty, revision in [(True, None), (False, "c" * 40)]:
            with self.subTest(dirty=dirty, revision=revision), tempfile.TemporaryDirectory() as temporary:
                cache = Path(temporary)
                packages = self.archives(cache, dirty=dirty, revision=revision)
                with self.assertRaises(ValueError):
                    module.check_archives(cache, self.pins, packages)


if __name__ == "__main__":
    unittest.main()
