#!/usr/bin/env bash
# Writes the two per-machine input documents a real run needs: a subject list
# naming the binaries built from this checkout, and a cluster profile naming the
# brokers and the tools that reach them.
#
# These two files are deliberately not committed. A scenario is reviewed and
# stable, but which binaries exist and where the brokers are is a fact about one
# machine on one day, and committing a guess at it would let a run bind to a
# path nobody checked. Generating them means the paths are absolute, current,
# and derived from the build that just happened.
#
# It exists as its own script because two callers need exactly the same pair:
# scripts/bench-suite-acceptance, which runs a suite against a developer's
# cluster, and the nightly workflow, which runs a pack against the dev compose
# cluster on a hosted runner. A workflow that wrote its own copy of these
# heredocs would be a second definition of what a subject is, free to drift.
#
# Building is part of the job: the documents name binaries by absolute path, so
# writing them without building would produce a subject list pointing at files
# that may not exist.
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
  echo "usage: scripts/generate-subject-config <outdir> [bootstrap] [qualified-candidate-checkout]" >&2
  exit 64
fi

outdir=$1
bootstrap=${2:-127.0.0.1:39092,127.0.0.1:39093,127.0.0.1:39094}
mkdir -p "$outdir"

echo "==> building the adapters"
build_arguments=()
if [[ "$#" -eq 3 ]]; then
  build_arguments=(--qualified-candidate "$3")
fi
binary_root=$("$repo_root/scripts/build-benchmark-adapters" "${build_arguments[@]}")
kafkars_adapter="$binary_root/kafkars-benchmark-adapter"
librdkafka_producer="$binary_root/librdkafka-producer-benchmark"
verifier="$binary_root/librdkafka-benchmark-verifier"
for binary in "$kafkars_adapter" "$librdkafka_producer" "$verifier"; do
  if [ ! -x "$binary" ]; then
    echo "missing built binary: $binary" >&2
    exit 70
  fi
done
if [[ "$#" -eq 3 ]]; then
  for name in candidate-provenance.json candidate-source-Cargo.lock candidate-adapter-Cargo.lock; do
    cp "$binary_root/$name" "$outdir/$name"
  done
fi

echo "==> building the control plane"
cargo build --locked -p benchctl -p bench-adapter-librdkafka --release
shim="$repo_root/target/release/bench-adapter-librdkafka"

echo "==> writing the generated inputs under $outdir"
cat >"$outdir/subjects.toml" <<TOML
# Generated by scripts/generate-subject-config. Both subjects are built from
# this checkout, so the paths are absolute and the file is not meant to be
# committed.
#
# The roles say which side of the comparison each subject is. They participate
# in the experiment id, so a suite that swapped them would be a different
# experiment rather than the same one read backwards.

[[subjects]]
name = "librdkafka-c"
role = "base"
command = ["$shim", "--binary", "$librdkafka_producer"]

[[subjects]]
name = "kafkars"
role = "head"
command = ["$kafkars_adapter"]
TOML

cat >"$outdir/cluster.toml" <<TOML
# Generated by scripts/generate-subject-config.
#
# Topic management and read-back verification are configured tools rather than
# adapter verbs: an adapter that created its own topics could choose its own
# partition count, and one that graded its own output would not be evidence.
name = "dev-compose"
bootstrap = "$bootstrap"
broker_version = "apache/kafka:4.3.1"
security = "plaintext"
brokers = 3
lifecycle = "externally managed by the caller"

[tools]
topic_create = ["$kafkars_adapter", "topics-create"]
topic_delete = ["$kafkars_adapter", "topics-delete"]
verify = ["$verifier"]
TOML
