#!/usr/bin/env bash
# Legacy Node control-plane gate: the migrated benchctl unit tests.
#
# The Node harness under legacy/benchctl is the behavioral reference for the
# Rust engine being built alongside it. Its tests encode what "sealed evidence"
# has meant so far — environment identity, checksum layout, validation refusals,
# statistics budgets — so they run on every change, not only when someone
# remembers the legacy path still exists.
#
# The version floor is a guard, not a preference. These modules use the built-in
# test runner and modern syntax that older runtimes accept only partially, and a
# partial acceptance surfaces as a confusing parse error deep inside a test file
# rather than as "your Node is too old". Failing loudly up front costs one line
# of output and saves the reader that investigation. The floor matches the
# engines range declared in package.json; changing one without the other makes
# the declaration a lie.
#
# The glob stays top-level on purpose. Subdirectories under legacy/benchctl hold
# implementation modules rather than tests, and recursing would silently change
# which files are treated as the suite.
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

required_major=22
required_minor=18

if ! command -v node >/dev/null 2>&1; then
  echo "check-control-plane: node was not found on PATH;" \
    "the legacy control plane requires Node >= $required_major.$required_minor" >&2
  exit 1
fi

node_version=$(node --version)
numeric=${node_version#v}
major=${numeric%%.*}
remainder=${numeric#*.}
minor=${remainder%%.*}

if [[ ! "$major" =~ ^[0-9]+$ ]] || [[ ! "$minor" =~ ^[0-9]+$ ]]; then
  echo "check-control-plane: could not parse the node version '$node_version'" >&2
  exit 1
fi

if ((major < required_major)) ||
  ((major == required_major && minor < required_minor)); then
  echo "check-control-plane: node $node_version is too old;" \
    "the legacy control plane requires Node >= $required_major.$required_minor" >&2
  exit 1
fi

node --test "$repo_root/legacy/benchctl/"*.test.mjs

# The one place legacy/ deliberately diverges from the harness it was extracted
# from, and the only thing guarding that divergence.
#
# Upstream, this control plane lived INSIDE the client repository, so its
# environment capture read the client's git state out of its own repository
# root: `kafka_client: gitState(repo)`. Here the client is a sibling checkout,
# so both capture sites resolve it through KAFKA_BENCH_CLIENT_ROOT falling back
# to `../kafkars`. See ARCHITECTURE.md, "The legacy plane".
#
# Why this is worth a tripwire rather than a comment. legacy/ is kept close to
# verbatim on purpose, which makes "restore fidelity with upstream" a plausible
# and well-intentioned edit. Making it would not break a test: the capture would
# succeed, the schema would still validate, and every bundle sealed afterwards
# would record THIS repository's git state under kafka_client — attributing the
# harness's own commit to the client under measurement. Every number in every
# such bundle would be labelled with the wrong subject, silently.
for capture in environment seal; do
  capture_file="$repo_root/legacy/benchctl/$capture.mjs"
  if ! LC_ALL=C grep -q 'KAFKA_BENCH_CLIENT_ROOT' "$capture_file"; then
    echo "check-control-plane: legacy/benchctl/$capture.mjs no longer honours" \
      "KAFKA_BENCH_CLIENT_ROOT; the client under measurement is a sibling" \
      "checkout here, not this repository" >&2
    exit 1
  fi
  if LC_ALL=C grep -q 'kafka_client: gitState(repo' "$capture_file"; then
    echo "check-control-plane: legacy/benchctl/$capture.mjs captures this" \
      "repository's git state as the client's; that is the upstream shape and" \
      "it mis-attributes every sealed bundle" >&2
    exit 1
  fi
done

echo "check-control-plane: ok"
